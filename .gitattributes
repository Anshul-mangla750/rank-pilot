# Set default behavior to automatically handle line endings and normalize to LF
* text=auto eol=lf

# Explicitly declare text files you always want to be normalized to LF
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
